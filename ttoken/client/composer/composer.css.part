
/* TTOken Code: the light redesign's composer. A flat white card with a strong
   hairline and no shadow, every control in the card's bottom row, and a round
   ink send button. These rules follow the upstream ones so they win at equal
   specificity. */
.card {
  --dsw-elevation-stroke-color: var(--dsw-alias-border-l4);
  border-radius: var(--dsw-radius-lg);
  box-shadow: var(--dsw-elevation-stroke);
}

.row {
  gap: 8px;
  padding: 2px 10px 10px;
}

.tools,
.modes,
.trailing,
.standardControls {
  gap: 8px;
}

.add {
  width: 36px;
  height: 36px;
  background: transparent;
  color: var(--dsw-alias-label-secondary);
}

@media (hover: hover) {
  .add:hover:not(:disabled) {
    background: var(--dsw-alias-interactive-bg-hover);
    color: var(--dsw-alias-label-primary);
  }
}

.primary {
  width: 40px;
  height: 40px;
  background: var(--dsw-alias-brand-primary);
  color: var(--dsw-alias-label-primary-foreground);
}

@media (hover: hover) {
  .primary:hover:not(:disabled) {
    background: var(--dsw-alias-button-primary-hover);
  }
}

.primary:disabled {
  opacity: 1;
  background: var(--dsw-alias-button-primary-dimmed);
  color: var(--dsw-alias-label-caption);
}

.primary[data-sending]:disabled {
  background: var(--dsw-alias-brand-primary);
  color: var(--dsw-alias-label-primary-foreground);
}
