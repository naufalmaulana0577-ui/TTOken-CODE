
/* TTOken Code: the desktop design's composer. Option chips sit above the card,
   send sits inside it beside the draft, and mode and model sit below it. These
   rules follow the upstream ones so they win at equal specificity. */
.ttokenChips {
  box-sizing: border-box;
  display: flex;
  align-items: flex-end;
  gap: 12px;
  width: 100%;
  max-width: var(--dsh-composer-card-max-width);
  padding: 0 2px 10px;
}

.ttokenChipList {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  flex: 1;
  min-width: 0;
}

.ttokenMark {
  flex: none;
  width: 32px;
  height: 28px;
  color: #ffb21a;
}

.card {
  gap: 0;
  padding-top: 0;
  border-radius: 16px;
  box-shadow: 0 0 0 1px var(--dsw-alias-border-l2), 0 1px 2px rgba(28, 27, 25, 0.04);
}

.ttokenEditorRow {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  padding: 12px 10px 10px 6px;
}

.ttokenEditorRow > .scroll {
  flex: 1;
  min-width: 0;
}

.ttokenSend {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: none;
}

.ttokenSendActive {
  flex: 1;
}

.ttokenFooter {
  box-sizing: border-box;
  width: 100%;
  max-width: var(--dsh-composer-card-max-width);
  padding: 8px 4px 0;
}

.add {
  background: transparent;
}

.primary {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: var(--dsw-alias-brand-primary);
  color: var(--dsw-alias-label-primary-foreground);
}

@media (hover: hover) {
  .primary:hover:not(:disabled) {
    background: var(--dsw-alias-button-primary-hover);
  }
}

.primary:disabled {
  opacity: 1;
  background: transparent;
  color: var(--dsw-alias-label-tertiary);
}

.primary[data-sending]:disabled {
  background: var(--dsw-alias-brand-primary);
  color: var(--dsw-alias-label-primary-foreground);
}
